#!/bin/zsh

set -u
PROJECT_DIR="$(cd "$(dirname "$0")/../../../.." && pwd)"
PYTHON="$PROJECT_DIR/.venv/bin/python"
URL="http://127.0.0.1:8765"

if /usr/bin/curl -fsS "$URL/api/status" >/dev/null 2>&1; then
  /usr/bin/open "$URL"
  exit 0
fi

if [[ ! -x "$PYTHON" ]]; then
  /usr/bin/osascript -e 'display dialog "尚未找到项目虚拟环境。请先按照 README 完成安装。" buttons {"好"} default button "好" with title "羽毛球预约控制台"'
  exit 1
fi

/bin/mkdir -p "$PROJECT_DIR/data"

# Keep the local dashboard server independent from the macOS launcher.  The
# launcher must exit after opening the browser; otherwise LaunchServices keeps
# the app marked as running and later double-clicks never execute this script.
/usr/bin/nohup "$PYTHON" "$PROJECT_DIR/ui_server.py" --no-open \
  >>"$PROJECT_DIR/data/ui_server.log" 2>&1 </dev/null &

for _ in {1..50}; do
  if /usr/bin/curl -fsS "$URL/api/status" >/dev/null 2>&1; then
    /usr/bin/open "$URL"
    exit 0
  fi
  /bin/sleep 0.1
done

/usr/bin/osascript -e 'display dialog "控制台服务启动失败，请查看 data/ui_server.log。" buttons {"好"} default button "好" with title "羽毛球预约控制台"'
exit 1
